# Copy to .env.local for local dev. Set the same keys in Vercel (Production / Preview).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Required for admin login and server-side API routes (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public site URL (no trailing slash). Used when the server calls its own API (e.g. notifications).
# Production example: https://mysurro.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blog auto-translate (DeepL). Server-only.
TRANSLATE_API_KEY=your_deepl_api_key
# TRANSLATE_API_URL=https://api-free.deepl.com/v2/translate

# Medical record Kimi K3 review. Server-only — never expose to the client.
# Get a key from https://platform.moonshot.ai / https://platform.kimi.ai
MOONSHOT_API_KEY=your_moonshot_api_key
# Optional aliases also accepted: KIMI_API_KEY
# Optional endpoint override (default: https://api.moonshot.ai/v1 ; China often uses https://api.moonshot.cn/v1)
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Optional model override (default: kimi-k3)
# MOONSHOT_MODEL=kimi-k3
