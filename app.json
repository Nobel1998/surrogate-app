{
  "expo": {
    "name": "mysurro",
    "slug": "surrogateagencyusa",
    "version": "1.7.9",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "surrogateagency",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "bundleIdentifier": "io.dcloud.mysurronew",
      "appStoreUrl": "https://apps.apple.com/app/id1492213410",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "mysurro",
        "NSCameraUsageDescription": "This app needs access to camera to take photos for sharing your surrogacy journey.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select photos for sharing your surrogacy journey.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "label": "mysurro",
      "package": "com.surrogateagencyusa",
      "backgroundColor": "#2A7BF6",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.surrogateagencyusa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2A7BF6"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {},
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them in your surrogacy journey posts.",
          "cameraPermission": "The app accesses your camera to let you take photos for your surrogacy journey posts."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-video",
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "22dc9389-73da-409f-a451-1d144bfef2f6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/22dc9389-73da-409f-a451-1d144bfef2f6"
    }
  }
}
